<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Keep cleartext disabled globally. Panel SPKI pinning is enforced by
         OkHttp's CertificatePinner in PanelClient, where the host is decoded
         at runtime instead of being duplicated in this XML resource. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
